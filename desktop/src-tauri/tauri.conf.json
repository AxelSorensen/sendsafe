{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SendSafe",
  "version": "0.1.4",
  "identifier": "com.sendsafe.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/server": "server"
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false,
      "entitlements": "Entitlements.plist",
      "dmg": {
        "background": "../dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 440
        },
        "appPosition": {
          "x": 165,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 190
        }
      }
    }
  }
}

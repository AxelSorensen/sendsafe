{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-window",
  "description": "Title bar drag, app version and in-app updates for the local app page",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*/*"] },
  "permissions": ["core:window:allow-start-dragging", "core:window:allow-toggle-maximize", "core:app:allow-version", "updater:default", "process:allow-restart"]
}
